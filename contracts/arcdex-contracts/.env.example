# Arc Testnet Configuration
# Copy this file to .env and fill in your private key
# Command: cp .env.example .env

ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.network"
ETHEREUM_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# Owner recomendado: multisig de testnet, nunca uma chave operacional isolada em producao.
CCIP_OWNER="0x0000000000000000000000000000000000000000"
ARC_CCIP_RECEIVER="0x0000000000000000000000000000000000000000"
ETHEREUM_CCIP_SENDER="0x0000000000000000000000000000000000000000"

# Your wallet private key (without 0x prefix or with, both work)
# ⚠️ NEVER commit .env to git!
PRIVATE_KEY="your_private_key_here"

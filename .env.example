# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=62a5e53db0163b7e29bc8b76c22d04cc

# Reown Project ID (same as WalletConnect, get from https://cloud.reown.com)
NEXT_PUBLIC_REOWN_PROJECT_ID=62a5e53db0163b7e29bc8b76c22d04cc

# ==========================================
# AI Assistant Configuration (OpenRouter)
# ==========================================
# Provider: openrouter (primary - opensource models)
NEXT_PUBLIC_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# OpenRouter Model Selection
# Recommended models (all opensource, fast, and affordable):
# - mistralai/mistral-7b-instruct (fastest, 7B)
# - openrouter/auto (automatic fallback to best available)
# - meta-llama/llama-2-70b (powerful 70B)
# - nousresearch/nous-hermes-2-mixtral-8x7b (excellent reasoning)
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Fallback Options (optional)
# Provider: groq | openrouter | ollama | huggingface
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# HuggingFace (alternative)
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-2-70B-Instruct

# AI Cache & Performance
ENABLE_AI_CACHE=true
CACHE_TTL_SECONDS=300

# ==========================================
# Bridge Configuration (Circle CCTP v2)
# ==========================================
NEXT_PUBLIC_BRIDGE_ENV=testnet

# ==========================================
# Elliptic Compliance (AML/CFT Screening)
# ==========================================
ELLIPTIC_API_KEY=
ELLIPTIC_API_SECRET=

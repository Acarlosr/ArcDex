# =============================================================================
# ArcDex — Configuração de ambiente
# =============================================================================
#
# A Arc Public Mainnet entra no ar em 16/09/2026. Até a Circle publicar os
# valores oficiais, deixe as variáveis NEXT_PUBLIC_ARC_MAINNET_* em branco:
# o app cai automaticamente na testnet e exibe o aviso de lançamento.
#
# Fontes oficiais:
#   https://docs.arc.io/arc/references/connect-to-arc
#   https://docs.arc.io/arc/references/contract-addresses
# =============================================================================

# -----------------------------------------------------------------------------
# Rede ativa: "mainnet" (padrão) ou "testnet"
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ARC_NETWORK=mainnet

# -----------------------------------------------------------------------------
# ARC MAINNET — preencher em 16/09/2026
# -----------------------------------------------------------------------------
# Chain ID e RPC são obrigatórios. Sem eles o app usa testnet.
NEXT_PUBLIC_ARC_MAINNET_CHAIN_ID=
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=
# RPCs de fallback separados por vírgula (Blockdaemon, dRPC, QuickNode, ...)
NEXT_PUBLIC_ARC_MAINNET_RPC_FALLBACKS=
NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=https://arcscan.app

# Stablecoins
NEXT_PUBLIC_ARC_MAINNET_USDC=
NEXT_PUBLIC_ARC_MAINNET_EURC=
NEXT_PUBLIC_ARC_MAINNET_USYC=

# CCTP v2
NEXT_PUBLIC_ARC_MAINNET_CCTP_DOMAIN=
NEXT_PUBLIC_ARC_MAINNET_CCTP_TOKEN_MESSENGER=
NEXT_PUBLIC_ARC_MAINNET_CCTP_MESSAGE_TRANSMITTER=
NEXT_PUBLIC_ARC_MAINNET_CCTP_TOKEN_MINTER=
NEXT_PUBLIC_ARC_MAINNET_CCTP_MESSAGE_V2=

# Gateway
NEXT_PUBLIC_ARC_MAINNET_GATEWAY_WALLET=
NEXT_PUBLIC_ARC_MAINNET_GATEWAY_MINTER=

# StableFX
NEXT_PUBLIC_ARC_MAINNET_FX_ESCROW=

# Contratos do ArcDex após o deploy em mainnet
NEXT_PUBLIC_ARC_MAINNET_ARCDEX_LP=
NEXT_PUBLIC_ARC_MAINNET_ARCDEX_SWAP=
NEXT_PUBLIC_ARC_MAINNET_ARCDEX_PAYMENTS=

# -----------------------------------------------------------------------------
# ARC TESTNET — overrides opcionais (defaults já no código)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ARCDEX_LP=
NEXT_PUBLIC_ARCDEX_SWAP=
NEXT_PUBLIC_ARCDEX_PAYMENTS=

# -----------------------------------------------------------------------------
# Carteira
# -----------------------------------------------------------------------------
# Obtenha em https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# -----------------------------------------------------------------------------
# IA (compliance / assistente)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ENABLE_AI_CACHE=true
CACHE_TTL_SECONDS=3600
